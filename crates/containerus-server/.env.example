# Containerus Server Configuration
# Copy this to .env and customize for your deployment

# PostgreSQL connection URL
# IMPORTANT: Change the username and password for production deployments
DATABASE_URL=postgres://containerus:containerus@localhost:5432/containerus

# Secret for signing JWT tokens (MUST be changed in production)
# Generate a unique value with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_UNIQUE_JWT_SECRET

# Secret for encrypting stored credentials (SSH keys, kubeconfigs)
# Generate a unique value with: openssl rand -base64 32
# MUST be different from JWT_SECRET
ENCRYPTION_KEY=CHANGE_ME_GENERATE_UNIQUE_ENCRYPTION_KEY

# Salt for encryption key derivation (Argon2). REQUIRED. Must be at least 8 characters.
# Must remain stable once set — changing it will invalidate all encrypted credentials.
# Generate a unique value with: openssl rand -base64 16
# MUST be different from JWT_SECRET and ENCRYPTION_KEY
ENCRYPTION_SALT=CHANGE_ME_GENERATE_UNIQUE_SALT

# Server bind address (default: 0.0.0.0:8080)
# BIND_ADDR=0.0.0.0:8080

# JWT access token expiry in seconds (default: 900 = 15 minutes)
# JWT_ACCESS_EXPIRY_SECS=900

# JWT refresh token expiry in seconds (default: 604800 = 7 days)
# JWT_REFRESH_EXPIRY_SECS=604800

# CORS allowed origins (default: http://localhost:1420)
# WARNING: Using * in production is a security risk. Always specify explicit origins.
# For Tauri desktop apps: tauri://localhost
# For web apps: https://app.example.com
# Multiple origins can be comma-separated
# CORS_ORIGINS=http://localhost:1420,tauri://localhost

# Log level
RUST_LOG=containerus_server=info,tower_http=info
